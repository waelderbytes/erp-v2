# Beispiel-Env fuer lokale Entwicklung / Tenant-Deployment.
# Reale Werte NIE committen (siehe .gitignore) - pro Tenant-Deployment eigene .env
# gemaess architecture.md Abschnitt 8 (Hosting-Strategie: 1 Compose-Stack pro Tenant).

# --- Postgres (Tenant-DB) ---
POSTGRES_USER=erp
POSTGRES_PASSWORD=changeme
POSTGRES_DB=erp_tenant

# --- Control-Plane (nur auf dem zentralen/Provisioning-Host relevant) ---
CONTROL_PLANE_DATABASE_URL=postgresql://erp:changeme@localhost:5432/erp_control_plane

# --- Tenant-DB Verbindung fuer die Services dieses Deployments ---
DATABASE_URL=postgresql://erp:changeme@localhost:5432/erp_tenant

# --- Auth-Service (eigener JWT-Auth, kein zentraler IdP - siehe architecture.md Abschnitt 1) ---
JWT_ACCESS_SECRET=changeme
JWT_REFRESH_SECRET=changeme
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Instanz-Identifikation (Subdomain bestimmt die Tenant-DB, siehe architecture.md) ---
INSTANCE_ID=inst001
INSTANCE_HOST=inst001.waelderbytes.de

# --- RabbitMQ (Event-Bus zwischen Services) ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672
